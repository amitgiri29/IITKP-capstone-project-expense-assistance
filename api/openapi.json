  "paths": {
    "/admin/evaluations": {
      "get": {
        "description": "Admin: every golden-case run under runtime/evaluation, newest first, with its status counts.",
        "operationId": "list_evaluations_admin_evaluations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Evaluations"
      }
    },
    "/admin/evaluations/{run}": {
      "get": {
        "description": "Admin: one run's summary and per-case results. Only case id, title, category, split and entrypoint are\nread from the suite; expected answers stay in the test files (they are never shown or sent to the model).",
        "operationId": "evaluation_detail_admin_evaluations__run__get",
        "parameters": [
          {
            "in": "path",
            "name": "run",
            "required": true,
            "schema": {
              "title": "Run",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
