{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed numeric rule registry",
  "description": "Authority for every number used by deterministic calculation. Each cap resolves to a policy rule ID and version.",
  "type": "object",
  "required": [
    "registry_version",
    "policy_version",
    "organization_id",
    "review_status",
    "effective_from",
    "effective_to",
    "caps",
    "parameters"
  ],
  "properties": {
    "registry_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "spec_version": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "fictional": {
      "type": "boolean"
    },
    "review_status": {
      "enum": [
        "DRAFT_PENDING_SECOND_REVIEWER",
        "REVIEWED",
        "SUPERSEDED"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "source_authority": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "unsupported_destination_behavior": {
      "type": "string"
    },
    "stale_entry_behavior": {
      "type": "string"
    },
    "caps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Cap"
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Cap": {
      "type": "object",
      "required": [
        "cap_id",
        "rule_id",
        "document_id",
        "policy_version",
        "category",
        "country_scope",
        "city_tier",
        "grade",
        "basis",
        "cap_currency",
        "cap_amount",
        "conversion_order",
        "effective_from",
        "effective_to",
        "scenario_group"
      ],
      "properties": {
        "cap_id": {
          "type": "string",
          "pattern": "^CAP-[A-Z0-9-]+$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "policy_version": {
          "type": "string"
        },
        "category": {
          "enum": [
            "hotel",
            "flight",
            "local_transport"
          ]
        },
        "country_scope": {
          "enum": [
            "IN",
            "US",
            "UK",
            "SG",
            "INTERNATIONAL"
          ]
        },
        "city_tier": {
          "enum": [
            "metro",
            "other",
            null
          ]
        },
        "grade": {
          "enum": [
            "E",
            "M"
          ]
        },
        "basis": {
          "enum": [
            "per_night",
            "per_one_way_journey",
            "per_local_day"
          ]
        },
        "cap_currency": {
          "enum": [
            "INR",
            "USD",
            "GBP",
            "SGD"
          ]
        },
        "cap_amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "conversion_order": {
          "enum": [
            "before_conversion",
            "after_conversion"
          ],
          "description": "before_conversion compares the line amount with a cap in the same currency, then converts. after_conversion converts first and compares with an INR cap, which is how P05 international flight caps work."
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": "string",
          "format": "date"
        },
        "scenario_group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Golden scenario group whose boundary cases exercise this cap, or null when the suite has no boundary coverage for it."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "required": [
        "parameter_id",
        "rule_id",
        "value",
        "unit",
        "notes"
      ],
      "properties": {
        "parameter_id": {
          "type": "string",
          "pattern": "^PARAM-[A-Z0-9-]+$"
        },
        "rule_id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
