{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expense assistant domain contracts",
  "description": "Reference definitions. Root accepts a documented domain object; consumers validate the appropriate $defs entry. Cross-field rules and authorization are enforced by application logic.",
  "oneOf": [
    {
      "$ref": "#/$defs/Assessment"
    },
    {
      "$ref": "#/$defs/ReceiptExtraction"
    },
    {
      "$ref": "#/$defs/TravelOffer"
    },
    {
      "$ref": "#/$defs/Critique"
    }
  ],
  "$defs": {
    "Money": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source_location": {
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "document_id",
        "version",
        "section",
        "text",
        "source_location"
      ],
      "additionalProperties": false
    },
    "Applicability": {
      "type": "object",
      "properties": {
        "grade": {
          "enum": [
            "E",
            "M",
            null
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "grade",
        "country",
        "city",
        "service_date"
      ],
      "additionalProperties": false
    },
    "ServerContext": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "authorized_session_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "traveler_id": {
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "session_id",
        "authorized_session_ids",
        "traveler_id"
      ],
      "additionalProperties": false
    },
    "ClaimContext": {
      "type": "object",
      "properties": {
        "grade": {
          "enum": [
            "E",
            "M",
            null
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "trip_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "trip_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "user_confirmed": {
          "type": "boolean"
        },
        "required_documents_present": {
          "type": "boolean"
        }
      },
      "required": [
        "grade",
        "country",
        "city",
        "trip_start",
        "trip_end",
        "submitted_on",
        "budget_inr",
        "coverage_complete",
        "user_confirmed",
        "required_documents_present"
      ],
      "additionalProperties": false
    },
    "ExpenseLine": {
      "type": "object",
      "properties": {
        "line_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "enum": [
            "hotel",
            "flight",
            "local_transport",
            "out_of_scope"
          ]
        },
        "service_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "journey_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cabin": {
          "type": [
            "string",
            "null"
          ]
        },
        "business_purpose": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fx_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "fx_rate_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "line_id",
        "receipt_id",
        "category",
        "service_date",
        "transaction_date",
        "country",
        "city",
        "currency",
        "amount",
        "excluded_amount",
        "journey_id",
        "cabin",
        "business_purpose",
        "evidence_ids",
        "fx_reference",
        "fx_rate_inr"
      ],
      "additionalProperties": false
    },
    "Assessment": {
      "type": "object",
      "properties": {
        "claimed_total_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_total_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_total_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "over_cap_total_inr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rounding_adjustment_inr": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        "budget_status": {
          "enum": [
            "WITHIN_BUDGET",
            "OVER_BUDGET",
            "UNKNOWN"
          ]
        },
        "compliance_status": {
          "enum": [
            "WITHIN_POLICY",
            "EXCEEDS_POLICY",
            "HAS_EXCLUSIONS",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "readiness": {
          "enum": [
            "INPUT_ERROR",
            "NEEDS_CLARIFICATION",
            "NEEDS_EVIDENCE",
            "HUMAN_REVIEW",
            "READY_FOR_REVIEW"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provisional_amounts": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "claimed_total_inr",
        "eligible_total_inr",
        "excluded_total_inr",
        "over_cap_total_inr",
        "rounding_adjustment_inr",
        "budget_status",
        "compliance_status",
        "readiness",
        "reasons",
        "evidence_ids",
        "missing_fields",
        "provisional_amounts"
      ],
      "additionalProperties": false
    },
    "ReceiptExtraction": {
      "type": "object",
      "properties": {
        "image_id": {
          "type": "string"
        },
        "merchant": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "service_dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "payable_total": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "label",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user_confirmed": {
          "type": "boolean"
        },
        "raw_visible_fields": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "image_id",
        "merchant",
        "receipt_id",
        "category",
        "currency",
        "service_dates",
        "payable_total",
        "components",
        "uncertainties",
        "user_confirmed",
        "raw_visible_fields"
      ],
      "additionalProperties": false
    },
    "Critique": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "REPAIR",
            "CLARIFY"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "issues",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "TravelSearchRequest": {
      "type": "object",
      "properties": {
        "search_type": {
          "enum": [
            "hotel",
            "flight"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "departure_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkin": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkout": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "grade": {
          "enum": [
            "E",
            "M",
            null
          ]
        },
        "travelers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "rooms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cabin": {
          "type": [
            "string",
            "null"
          ]
        },
        "journey_type": {
          "enum": [
            "one_way",
            "return",
            null
          ]
        }
      },
      "required": [
        "search_type"
      ],
      "additionalProperties": false
    },
    "TravelOffer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "DEMO",
            "LIVE"
          ]
        },
        "type": {
          "enum": [
            "hotel",
            "flight"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "currency": {
          "type": "string"
        },
        "price_basis": {
          "enum": [
            "per_traveler_one_way",
            "per_room_stay"
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "nightly_totals": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "taxes_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mandatory_fees_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "baggage_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "baggage_fee_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cancellation_terms": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_status": {
          "enum": [
            "COMPLIANT",
            "NONCOMPLIANT",
            "PROVISIONAL",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "provider",
        "mode",
        "type",
        "retrieved_at",
        "expires_at",
        "currency",
        "price_basis",
        "total",
        "nightly_totals",
        "taxes_included",
        "mandatory_fees_included",
        "baggage_kg",
        "baggage_fee_included",
        "duration_minutes",
        "distance_km",
        "cancellation_terms",
        "policy_status",
        "reasons",
        "evidence_ids"
      ],
      "additionalProperties": true
    }
  }
}
