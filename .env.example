# Documentation template. No real credentials. Read DECISIONS.json before live calls.
APP_MODE=demo
MODEL_PROVIDER=
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_REVISION=
MODEL_API_KEY=
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL_ID=
EMBEDDING_API_KEY=
OCR_ENABLED=false
OCR_API_KEY=
TRAVEL_MODE=fixture
TRAVEL_PROVIDER=
TRAVEL_API_REVISION=
TRAVEL_API_KEY=
FX_PROVIDER=
FX_API_KEY=
# Fill approved limits during setup; blanks must not mean unlimited live execution.
MAX_MODEL_CALLS_PER_RUN=
RUN_TIMEOUT_SECONDS=
DAILY_SPEND_LIMIT=
TRACE_MODE=redacted


# LangSmith — enable after workspace/region and masking checks are completed.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Choose ONE destination mode and remove the unused lines when enabling tracing:
# Agent-based workspace:
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=local
# Project-based workspace:
# LANGSMITH_PROJECT=expense-policy-dev
# Application-owned budget/configuration, not LangSmith SDK environment variables:
LANGSMITH_MONTHLY_BUDGET=

# AWS deployment values — fill only for the authorized AWS environment.
DEPLOY_ENV=local
AWS_REGION=
AWS_RECEIPTS_BUCKET=
AWS_RECEIPTS_PREFIX=
AWS_SECRETS_PREFIX=
TRUSTED_ALB_ARN=
PUBLIC_BASE_URL=
# No static AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY; use the approved role/provider chain.

# Model provider overrides read by the app (core/settings.py). Leave commented to use config/settings.toml.
# Claude API key instead of the Claude Code CLI:
# EXPENSE_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
#
# Qwen + embeddings hosted on Colab: colab/qwen_vllm_server.ipynb prints this block with real values.
# EXPENSE_MODEL_PROVIDER=openai_compatible
# EXPENSE_MODEL_BASE_URL=https://<random>.trycloudflare.com/v1
# EXPENSE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
# EXPENSE_MODEL_API_KEY_ENV=COLAB_API_KEY
# EXPENSE_MODEL_MAX_OUTPUT_TOKENS=4096
# EXPENSE_MODEL_SUPPORTS_VISION=false
# EXPENSE_EMBEDDINGS_PROVIDER=openai_compatible
# EXPENSE_EMBEDDINGS_BASE_URL=https://<random>.trycloudflare.com/v1
# EXPENSE_EMBEDDINGS_MODEL_ID=BAAI/bge-small-en-v1.5
# EXPENSE_EMBEDDINGS_API_KEY_ENV=COLAB_API_KEY
# COLAB_API_KEY=
